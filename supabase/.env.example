# 이 파일을 supabase/.env.local 로 복사해 값을 채운다. (git 에 올라가지 않는다)
#
# OPENAI_API_KEY
#   Edge Function 의 시크릿으로만 저장된다. Flutter 앱에는 들어가지 않는다.
#   https://platform.openai.com/api-keys
#
# SUPABASE_ACCESS_TOKEN
#   Edge Function 을 배포할 때만 쓰는 개인 액세스 토큰이다.
#   https://supabase.com/dashboard/account/tokens
OPENAI_API_KEY=
SUPABASE_ACCESS_TOKEN=
