# Vercel 프로젝트 환경변수에만 넣는다. 이 파일에는 실제 값을 적지 않는다.
# (앱에는 어떤 값도 넘기지 않는다. APK 에 들어가는 것은 API_BASE_URL 뿐이다.)

# Supabase 프로젝트 주소
SUPABASE_URL=https://<project-ref>.supabase.co

# 서버 전용 키. 브라우저·앱에 절대 노출하지 않는다.
# service_role 이 없으면 공개 키로도 읽기는 되지만, 서버에서는 service_role 을 쓴다.
SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# OpenAI
OPENAI_API_KEY=<openai api key>
OPENAI_MODEL=gpt-5-nano

# 쉼표로 구분한 허용 출처. 비우면 모든 출처를 허용한다(앱은 출처를 보내지 않는다).
ALLOWED_ORIGINS=

# 추천 호출 제한(분당, IP 기준). 비우면 기본값 10.
RECOMMEND_RATE_LIMIT_PER_MINUTE=10
